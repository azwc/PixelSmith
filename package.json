{
  "name": "pixelsmith-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A source-only, from-scratch pixel-art UI kit for Vue 3 and vanilla HTML/CSS/JS. Generated with DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "azwc <228516415@qq.com>",
  "homepage": "https://github.com/azwc/PixelSmith#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/azwc/PixelSmith.git"
  },
  "bugs": {
    "url": "https://github.com/azwc/PixelSmith/issues"
  },
  "keywords": [
    "pixel",
    "retro",
    "8-bit",
    "ui",
    "vue",
    "css",
    "components",
    "design-system"
  ],
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build:lib": "vite build --config vite.config.ts",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "build:vue-umd": "vite build --config vite.vue-umd.config.ts",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build": "pnpm run build:lib && pnpm run build:standalone && pnpm run build:vue-umd && pnpm run build:types",
    "build:demo": "vite build --config vite.demo.config.ts && node scripts/prepare-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --config vite.demo.config.ts",
    "qa": "node scripts/qa.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.5.1",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  }
}
